# =========================================================================
# IPL Big Data Analytics - Environment Configuration
# Copy this file to .env and adjust variables as needed
# =========================================================================

# Spark Cluster Settings
SPARK_MASTER=spark://spark-master:7077
SPARK_LOCAL_MASTER=local[*]
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# Hadoop HDFS Settings
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_PORT=9000
HDFS_NAMENODE_WEB_PORT=9870
HDFS_DATANODE_WEB_PORT=9864

# Host Connection Settings (used when running scripts directly from macOS terminal)
HDFS_LOCAL_HOST=localhost
SPARK_LOCAL_HOST=localhost

# Streamlit Dashboard Settings (Port 8502 used to avoid conflict with other apps)
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=0.0.0.0
